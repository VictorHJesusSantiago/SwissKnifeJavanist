<idea-plugin>
    <id>dev.swissknife.productivity</id>
    <name>SwissKnife Javanist</name>
    <vendor email="dev@swissknife.local">SwissKnife</vendor>
    <description><![CDATA[
        SwissKnife Javanist provides project documentation, technical-debt
        tracking, Java quality analysis, security scanning, architecture
        visualization, and Spring Boot governance directly inside the IDE.
    ]]></description>
    <depends>com.intellij.modules.platform</depends>
    <actions>
        <group id="SwissKnife.Menu" text="SwissKnife" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <action id="SwissKnife.GenerateDocs"
                    class="dev.swissknife.intellij.GenerateDocsAction"
                    text="Gerar documentação"/>
            <action id="SwissKnife.ScanDebt"
                    class="dev.swissknife.intellij.ScanDebtAction"
                    text="Analisar débito técnico"/>
            <separator/>
            <action id="SwissKnife.Quality"
                    class="dev.swissknife.intellij.QualityAction"
                    text="Analisar qualidade Java"/>
            <action id="SwissKnife.Security"
                    class="dev.swissknife.intellij.SecurityScanAction"
                    text="Verificar segurança"/>
            <action id="SwissKnife.Architecture"
                    class="dev.swissknife.intellij.ArchitectureAction"
                    text="Gerar mapa arquitetural"/>
            <action id="SwissKnife.SpringAudit"
                    class="dev.swissknife.intellij.SpringAuditAction"
                    text="Auditar Spring Boot"/>
            <separator/>
            <action id="SwissKnife.DependencyAudit"
                    class="dev.swissknife.intellij.DependencyAuditAction"
                    text="Auditar dependências e SBOM"/>
            <action id="SwissKnife.TestAudit"
                    class="dev.swissknife.intellij.TestAuditAction"
                    text="Auditar testes"/>
            <action id="SwissKnife.Modernize"
                    class="dev.swissknife.intellij.ModernizeAction"
                    text="Planejar modernização"/>
            <action id="SwissKnife.ReleaseReadiness"
                    class="dev.swissknife.intellij.ReleaseReadinessAction"
                    text="Prontidão de release"/>
        </group>
    </actions>
</idea-plugin>
